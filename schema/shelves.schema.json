{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linkmery/shelves.schema.json",
  "title": "Linkmery shelves",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "order"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,30}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "kind": {
        "enum": [
          "pinned",
          "recent",
          "gems"
        ],
        "description": "Virtual shelves that are computed, not assigned."
      },
      "note": {
        "type": "string"
      },
      "color": {
        "type": "string"
      },
      "area": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "w": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "h": {
            "type": "integer",
            "minimum": 1
          }
        },
        "description": "Optional; no longer drawn, kept for older data."
      }
    }
  }
}
